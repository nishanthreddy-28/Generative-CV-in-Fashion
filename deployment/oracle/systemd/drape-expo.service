[Unit]
Description=Drape and Drop Expo phone testing
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=drapedrop
Group=drapedrop
WorkingDirectory=/opt/drape-drop/mobile
Environment=HOME=/opt/drape-drop
Environment=HF_HOME=/opt/drape-drop/cache/huggingface
Environment=MPLCONFIGDIR=/opt/drape-drop/cache/matplotlib
Environment=TOKENIZERS_PARALLELISM=false
Environment=OMP_NUM_THREADS=4
Environment=CUDA_VISIBLE_DEVICES=-1
Environment=CI=1
Environment=PATH=/opt/drape-drop/node/bin:/usr/local/bin:/usr/bin:/bin
Environment=EXPO_PACKAGER_PROXY_URL=https://YOUR_TUNNEL_HOST
ExecStart=/opt/drape-drop/node/bin/node node_modules/expo/bin/cli start --go --localhost --port 8081
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/drape-drop

[Install]
WantedBy=multi-user.target
