# Hosting environment variables, not frontend variables.
# This template is not automatically loaded by the app.
PHASE3_LLM_PROVIDER=workers
PHASE3_GEMINI_MODEL=gemini-3.6-flash
# Set PHASE3_LLM_PROVIDER=groq to select Groq explicitly.
PHASE3_GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional alternate chatbot/visual-assessment providers; Workers/Gemma is selected.
# PHASE3_LLM_PROVIDER=workers | nvidia | siliconflow
PHASE3_WORKERS_MODEL=@cf/google/gemma-4-26b-a4b-it
PHASE3_NVIDIA_MODEL=google/gemma-4-31b-it
NVIDIA_API_KEY=
PHASE3_SILICONFLOW_MODEL=Qwen/Qwen3-VL-8B-Instruct
SILICONFLOW_API_KEY=
# Keep blocked until the account has confirmed zero-cost access for the test.
SILICONFLOW_FREE_TEST_CONFIRMED=0
# Cloudflare Gemma chatbot/visual assessment. Backend secrets only.
# Stay on Workers Free to stop at the free daily limit. The adapter cannot inspect billing status.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
PHASE3_TRYON_PROVIDER=weshop
# Only weshop and idm are supported for image generation.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Do NOT set PHASE3_DEV_USER_ID on a deployed service.
# Local Ollama remains available with PHASE3_LLM_PROVIDER=ollama.
